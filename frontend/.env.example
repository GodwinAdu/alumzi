# API Configuration
API_BASE_URL=http://localhost:8000/api
SERVER_URL=http://localhost:8000

# Development Configuration
EXPO_PUBLIC_API_URL=http://localhost:8000/api
EXPO_PUBLIC_API_URL_ANDROID=http://YOUR_LOCAL_IP:8000/api
EXPO_PUBLIC_WS_URL=http://localhost:8000
EXPO_PUBLIC_WS_URL_ANDROID=http://YOUR_LOCAL_IP:8000

# Network Configuration (Update with your local IP for device testing)
# Replace 192.168.1.170 with your actual local IP address
LOCAL_IP=192.168.1.170
EXPO_PUBLIC_LOCAL_IP=192.168.1.170

# Environment
NODE_ENV=development
EXPO_PUBLIC_ENV=development

# Deep Linking
EXPO_PUBLIC_SCHEME=alumzi

# Optional: Analytics and Monitoring
# EXPO_PUBLIC_ANALYTICS_KEY=your_analytics_key
# EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn